#!/bin/sh
# Every commit message carries the game version it builds (c_VersionString in Source/System/GameVersion.h, as the pre-commit hook left
# it): "[x.y.z] " at the front of the title, so the version shows in GitHub's commit list, and a "Version x.y.z" line at the end, unless
# the message has them already.
file="Source/System/GameVersion.h"
msg="$1"
[ -f "$file" ] || exit 0
version=$(sed -n -E 's/.*c_VersionString = "([0-9]+\.[0-9]+\.[0-9]+)".*/\1/p' "$file")
[ -n "$version" ] || exit 0
# The title: the first line that isn't a comment (git strips those).
if ! grep -v '^#' "$msg" | head -n 1 | grep -q "^\[$version\] "; then
	tmp="$msg.tmp"
	awk -v v="$version" 'BEGIN { done = 0 } { if (!done && $0 !~ /^#/) { print "[" v "] " $0; done = 1 } else { print } }' "$msg" > "$tmp" && mv "$tmp" "$msg"
fi
if ! grep -q "^Version $version$" "$msg"; then
	printf '\nVersion %s\n' "$version" >> "$msg"
fi
exit 0
